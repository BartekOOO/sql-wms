<Window x:Class="SQLWMS.AddDocumentPositionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nowa pozycja"
        Width="760"
    Height="620"
        MinWidth="760"
    MinHeight="620"
        ResizeMode="NoResize"
    WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        Background="#F2EDE4"
        FontFamily="Bahnschrift"
        UseLayoutRounding="True"
        ShowInTaskbar="False">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#173B47" />
        <SolidColorBrush x:Key="AccentBrush" Color="#BE6943" />
        <SolidColorBrush x:Key="MutedBrush" Color="#65757C" />

        <Style x:Key="DialogPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#224C5A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#102B34" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogGhostButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#12FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="#284F5D" />
            <Setter Property="BorderThickness" Value="1.2" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#18FFFFFF" />
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,8" />
        </Style>
    </Window.Resources>

    <Grid Margin="22,18,22,18"
          MouseLeftButtonDown="RootGrid_MouseLeftButtonDown">
        <Border Background="#FBF8F3"
                BorderBrush="#D4C9BA"
                BorderThickness="1.4"
                CornerRadius="4"
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock x:Name="DialogTitleTextBlock"
                               Text="Nowa pozycja dokumentu"
                               Foreground="{StaticResource PrimaryBrush}"
                               FontSize="22"
                               FontWeight="SemiBold" />
                </StackPanel>

                <TabControl Grid.Row="2" Margin="0,18,0,0" Background="Transparent" BorderThickness="0">
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="TabItem" BasedOn="{StaticResource EditorTabItemStyle}" />
                    </TabControl.ItemContainerStyle>

                    <TabItem Header="Ogolne">
                        <Border Margin="0,10,0,0"
                                Padding="16"
                                Background="#F7F2EA"
                                BorderBrush="#D8CEC0"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Towar"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               FontSize="13"
                                               FontWeight="SemiBold" />
                                    <ComboBox x:Name="ProductComboBox"
                                              Margin="0,8,0,0"
                                              Height="30"
                                              Padding="6,4"
                                              Background="White"
                                              BorderBrush="#D7CCC0"
                                              BorderThickness="1.2"
                                              FontSize="13"
                                              VerticalContentAlignment="Center"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Code"
                                              SelectionChanged="ProductComboBox_SelectionChanged" />
                                </StackPanel>

                                <Grid Grid.Row="1" Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.3*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="0.9*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="0.9*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="Jednostka"
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold" />
                                        <ComboBox x:Name="UnitComboBox"
                                                  Margin="0,8,0,0"
                                                  Height="30"
                                                  Padding="6,4"
                                                  Background="White"
                                                  BorderBrush="#D7CCC0"
                                                  BorderThickness="1.2"
                                                  FontSize="13"
                                                  VerticalContentAlignment="Center"
                                                  SelectionChanged="UnitComboBox_SelectionChanged"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedValuePath="Code" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock x:Name="QuantityLabelTextBlock"
                                                   Text="Ilosc w jednostce pozycji"
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold" />
                                        <TextBox x:Name="QuantityTextBox"
                                                 Margin="0,8,0,0"
                                                 Height="30"
                                                 Padding="10,4"
                                                 Background="White"
                                                 BorderBrush="#D7CCC0"
                                                 BorderThickness="1.2"
                                                 FontSize="13"
                                                 VerticalContentAlignment="Center"
                                                 TextChanged="QuantityTextBox_TextChanged"
                                                 Text="1" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock x:Name="BaseQuantityLabelTextBlock"
                                                   Text="Ilosc w jednostce podstawowej"
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold" />
                                        <TextBox x:Name="BaseQuantityTextBox"
                                                 Margin="0,8,0,0"
                                                 Height="30"
                                                 Padding="10,4"
                                                 Background="White"
                                                 BorderBrush="#D7CCC0"
                                                 BorderThickness="1.2"
                                                 FontSize="13"
                                                 VerticalContentAlignment="Center"
                                                 TextChanged="BaseQuantityTextBox_TextChanged"
                                                 Text="1" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel x:Name="FeaturePanel" Grid.Row="2" Margin="0,18,0,0">
                                    <TextBlock Text="Cecha"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               FontSize="13"
                                               FontWeight="SemiBold" />
                                    <TextBox x:Name="FeatureTextBox"
                                             Margin="0,8,0,0"
                                             Height="34"
                                             Padding="10,4"
                                             Background="White"
                                             BorderBrush="#D7CCC0"
                                             BorderThickness="1.2"
                                             FontSize="13"
                                             VerticalContentAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </TabItem>

                    <TabItem x:Name="AllocationsTabItem" Header="Alokacje">
                        <Border Margin="0,10,0,0"
                                Padding="16"
                                Background="#F7F2EA"
                                BorderBrush="#D8CEC0"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="Alokacje przypisane do tej pozycji. Ilosc do rozbicia mozesz podawac w jednostce pozycji albo w jednostce podstawowej, a rozbicie i usuniecie dziala na zaznaczonej alokacji."
                                           Foreground="#5D6B71"
                                           FontSize="12"
                                           TextWrapping="Wrap" />

                                <TextBlock x:Name="AllocationNewPositionTextBlock"
                                           Grid.Row="1"
                                           Margin="0,14,0,0"
                                           VerticalAlignment="Top"
                                           Foreground="#5D6B71"
                                           FontSize="13"
                                           Text="Alokacje beda dostepne po zapisaniu pozycji." />

                                <TextBlock x:Name="AllocationEmptyStateTextBlock"
                                           Grid.Row="1"
                                           Margin="0,14,0,0"
                                           VerticalAlignment="Top"
                                           Foreground="#5D6B71"
                                           FontSize="13"
                                           Visibility="Collapsed"
                                           Text="Brak alokacji dla tej pozycji." />

                                <DataGrid x:Name="AllocationsDataGrid"
                                          Grid.Row="1"
                                          Margin="0,14,0,0"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserSortColumns="False"
                                          HeadersVisibility="Column"
                                          RowHeaderWidth="0"
                                          GridLinesVisibility="All"
                                          HorizontalGridLinesBrush="#DDE5E3"
                                          VerticalGridLinesBrush="#DCCFC0"
                                          AlternatingRowBackground="#FFF8F3EA"
                                          RowBackground="White"
                                          Background="White"
                                          BorderBrush="#D6E0DD"
                                          BorderThickness="1"
                                          MinHeight="220"
                                          SelectionChanged="AllocationsDataGrid_SelectionChanged"
                                          Visibility="Collapsed">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Cecha" Binding="{Binding DisplayFeature}" Width="*" />
                                        <DataGridTextColumn Header="Kierunek" Binding="{Binding Direction}" Width="120" />
                                        <DataGridTextColumn Header="Dokument zrodlowy" Binding="{Binding SourceDocumentNumber}" Width="210" />
                                        <DataGridTextColumn Header="Ilosc" Binding="{Binding UnitQuantity, StringFormat={}{0:0.###}}" Width="140" />
                                        <DataGridTextColumn Header="Ilosc podstawowa" Binding="{Binding Quantity, StringFormat={}{0:0.###}}" Width="170" />
                                        <DataGridTextColumn Header="Jednostka" Binding="{Binding UnitCode}" Width="120" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Grid x:Name="AllocationActionPanel" Grid.Row="2" Margin="0,16,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock x:Name="AllocationSplitQuantityLabelTextBlock"
                                                   Text="Ilosc do rozbicia"
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold" />
                                        <TextBox x:Name="AllocationSplitQuantityTextBox"
                                                 Margin="0,8,0,0"
                                                 Height="30"
                                                 Padding="10,4"
                                                 Background="White"
                                                 BorderBrush="#D7CCC0"
                                                 BorderThickness="1.2"
                                                 FontSize="13"
                                                 VerticalContentAlignment="Center"
                                                 TextChanged="AllocationSplitQuantityTextBox_TextChanged" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock x:Name="AllocationSplitBaseQuantityLabelTextBlock"
                                                   Text="Ilosc podstawowa"
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold" />
                                        <TextBox x:Name="AllocationSplitBaseQuantityTextBox"
                                                 Margin="0,8,0,0"
                                                 Height="30"
                                                 Padding="10,4"
                                                 Background="White"
                                                 BorderBrush="#D7CCC0"
                                                 BorderThickness="1.2"
                                                 FontSize="13"
                                                 VerticalContentAlignment="Center"
                                                 TextChanged="AllocationSplitBaseQuantityTextBox_TextChanged" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="4">
                                        <TextBlock Text="Nowa cecha"
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold" />
                                        <TextBox x:Name="AllocationSplitFeatureTextBox"
                                                 Margin="0,8,0,0"
                                                 Height="30"
                                                 Padding="10,4"
                                                 Background="White"
                                                 BorderBrush="#D7CCC0"
                                                 BorderThickness="1.2"
                                                 FontSize="13"
                                                 VerticalContentAlignment="Center" />
                                    </StackPanel>

                                            <StackPanel Grid.Row="1"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="5"
                                                Margin="0,16,0,0"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right">
                                            <Button x:Name="SplitAllocationButton"
                                                Width="130"
                                                Height="30"
                                                Style="{StaticResource DialogPrimaryButtonStyle}"
                                                Click="SplitAllocationButton_Click"
                                                Content="Rozbij" />

                                            <Button x:Name="DeleteAllocationButton"
                                                Width="120"
                                                Height="30"
                                                Margin="12,0,0,0"
                                                Style="{StaticResource DialogGhostButtonStyle}"
                                                Click="DeleteAllocationButton_Click"
                                                Content="Usun" />
                                            </StackPanel>
                                </Grid>

                                <TextBlock x:Name="AllocationValidationTextBlock"
                                           Grid.Row="3"
                                           Margin="0,12,0,0"
                                           Foreground="#B42318"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </TabItem>
                </TabControl>

                <Grid Grid.Row="3" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="ValidationTextBlock"
                               VerticalAlignment="Center"
                               Foreground="#B42318"
                               FontSize="12"
                               TextWrapping="Wrap" />

                    <Button Grid.Column="1"
                            Width="96"
                            Height="30"
                            Margin="0,0,8,0"
                            Style="{StaticResource DialogGhostButtonStyle}"
                            Click="CancelButton_Click"
                            Content="Anuluj" />

                    <Button x:Name="AddButton"
                            Grid.Column="2"
                            Width="118"
                            Height="30"
                            Style="{StaticResource DialogPrimaryButtonStyle}"
                            Click="AddButton_Click"
                            Content="Dodaj pozycje" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>