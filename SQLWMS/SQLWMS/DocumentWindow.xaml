<Window x:Class="SQLWMS.DocumentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        Title="Dokument"
        Width="980"
        Height="700"
        MinWidth="920"
        MinHeight="640"
        ResizeMode="CanMinimize"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        Background="#F2EDE4"
        FontFamily="Bahnschrift"
        UseLayoutRounding="True"
        ShowInTaskbar="False">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#173B47" />
        <SolidColorBrush x:Key="AccentBrush" Color="#BE6943" />
        <SolidColorBrush x:Key="MutedBrush" Color="#65757C" />

        <Style x:Key="FooterActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#224C5A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#102B34" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#12FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="#284F5D" />
            <Setter Property="BorderThickness" Value="1.2" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#18FFFFFF" />
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectorClearButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostActionButtonStyle}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="8,10,0,0" />
        </Style>

        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="FormValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="FormComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D7CCC0" />
            <Setter Property="BorderThickness" Value="1.2" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D7CCC0" />
            <Setter Property="BorderThickness" Value="1.2" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="FormDateEditStyle" TargetType="{x:Type dxe:DateEdit}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D7CCC0" />
            <Setter Property="BorderThickness" Value="1.2" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#DCE8EA" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="#C6D5D8" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,20"
          MouseLeftButtonDown="RootGrid_MouseLeftButtonDown">
        <Border Background="#FBF8F3"
                BorderBrush="#D4C9BA"
                BorderThickness="1.4"
                CornerRadius="4"
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock x:Name="DocumentTitleTextBlock"
                               Foreground="{StaticResource PrimaryBrush}"
                               FontSize="24"
                               FontWeight="SemiBold" />
                </StackPanel>

                <Border x:Name="ReadOnlyBannerBorder"
                        Grid.Row="1"
                        Margin="0,14,0,0"
                        Padding="14,10"
                        Visibility="Collapsed"
                        CornerRadius="4"
                        Background="#FFF2E8"
                        BorderBrush="#E6B28F"
                        BorderThickness="1">
                    <TextBlock x:Name="ReadOnlyBannerTextBlock"
                               Foreground="#8A3B12"
                               FontSize="12"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                </Border>

                <Grid Grid.Row="2" Margin="0,18,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Padding="16"
                            CornerRadius="4"
                            Background="#EDF3F0"
                            BorderBrush="#D6E0DD"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Numer dokumentu" Style="{StaticResource FormLabelStyle}" />
                            <TextBlock Grid.Column="1" x:Name="NumerDokumentuTextBlock" Margin="0,0,18,0" Style="{StaticResource FormValueStyle}" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Grid.Column="2" Text="Typ dokumentu" Style="{StaticResource FormLabelStyle}" />
                            <TextBlock Grid.Column="3" x:Name="TypDokumentuTextBlock" Style="{StaticResource FormValueStyle}" FontWeight="SemiBold" FontSize="14" />

                            <TextBlock Grid.Row="1" Text="Status" Margin="0,10,0,0" Style="{StaticResource FormLabelStyle}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="StatusDokumentuTextBlock" Margin="0,10,18,0" Style="{StaticResource FormValueStyle}" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Data dokumentu" Margin="0,10,0,0" Style="{StaticResource FormLabelStyle}" />
                            <dxe:DateEdit Grid.Row="1"
                                          Grid.Column="3"
                                          x:Name="DocumentDateEdit"
                                          Margin="0,10,0,0"
                                          NullText="Wybierz date"
                                          Mask="dd.MM.yyyy"
                                          MaskUseAsDisplayFormat="True"
                                          LostFocus="EditableField_LostFocus"
                                          Style="{StaticResource FormDateEditStyle}" />

                            <TextBlock Grid.Row="2" Text="Magazyn zrodlowy" Margin="0,10,0,0" Style="{StaticResource FormLabelStyle}" />
                            <ComboBox Grid.Row="2"
                                      Grid.Column="1"
                                      x:Name="SourceWarehouseComboBox"
                                      Margin="0,10,18,0"
                                      Style="{StaticResource FormComboBoxStyle}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValuePath="Code"
                                      SelectionChanged="SourceWarehouseComboBox_SelectionChanged" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Sektor zrodlowy" Margin="0,10,0,0" Style="{StaticResource FormLabelStyle}" />
                            <Grid Grid.Row="2" Grid.Column="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0"
                                          x:Name="SourceSectorComboBox"
                                          Margin="0,10,0,0"
                                          Style="{StaticResource FormComboBoxStyle}"
                                          DisplayMemberPath="DisplayName"
                                          SelectionChanged="DocumentField_SelectionChanged" />
                                <Button Grid.Column="1"
                                        x:Name="SourceSectorClearButton"
                                        Style="{StaticResource SectorClearButtonStyle}"
                                        Click="SourceSectorClearButton_Click"
                                        Content="X"
                                        ToolTip="Odepnij sektor" />
                            </Grid>

                            <TextBlock Grid.Row="3" Text="Magazyn docelowy" Margin="0,10,0,0" Style="{StaticResource FormLabelStyle}" />
                            <ComboBox Grid.Row="3"
                                      Grid.Column="1"
                                      x:Name="DestinationWarehouseComboBox"
                                      Margin="0,10,18,0"
                                      Style="{StaticResource FormComboBoxStyle}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValuePath="Code"
                                      SelectionChanged="DestinationWarehouseComboBox_SelectionChanged" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="Sektor docelowy" Margin="0,10,0,0" Style="{StaticResource FormLabelStyle}" />
                            <Grid Grid.Row="3" Grid.Column="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0"
                                          x:Name="DestinationSectorComboBox"
                                          Margin="0,10,0,0"
                                          Style="{StaticResource FormComboBoxStyle}"
                                          DisplayMemberPath="DisplayName"
                                          SelectionChanged="DocumentField_SelectionChanged" />
                                <Button Grid.Column="1"
                                        x:Name="DestinationSectorClearButton"
                                        Style="{StaticResource SectorClearButtonStyle}"
                                        Click="DestinationSectorClearButton_Click"
                                        Content="X"
                                        ToolTip="Odepnij sektor" />
                            </Grid>

                            <TextBlock Grid.Row="4" Text="Opis" Margin="0,10,0,0" Style="{StaticResource FormLabelStyle}" />
                            <TextBox Grid.Row="4"
                                     Grid.Column="1"
                                     Grid.ColumnSpan="3"
                                     x:Name="DescriptionTextBox"
                                     Margin="0,10,0,0"
                                     MinHeight="66"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     AcceptsReturn="True"
                                     LostFocus="EditableField_LostFocus"
                                     TextWrapping="Wrap"
                                     VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Margin="0,14,0,0"
                            Padding="10"
                            CornerRadius="4"
                            Background="#EDF3F0"
                            BorderBrush="#D6E0DD"
                            BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <TextBlock Text="Pozycje dokumentu"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           FontSize="14"
                                           FontWeight="SemiBold" />
                            </Grid>

                            <DataGrid x:Name="DocumentPositionsDataGrid"
                                      Grid.Row="1"
                                      Margin="0,10,0,0"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserSortColumns="False"
                                      EnableRowVirtualization="False"
                                      HeadersVisibility="Column"
                                      RowHeaderWidth="0"
                                      GridLinesVisibility="All"
                                      HorizontalGridLinesBrush="#DDE5E3"
                                      VerticalGridLinesBrush="#DCCFC0"
                                      AlternatingRowBackground="#FFF8F3EA"
                                      RowBackground="White"
                                      Background="White"
                                      BorderBrush="#D6E0DD"
                                      BorderThickness="1"
                                      ScrollViewer.CanContentScroll="False"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      MinColumnWidth="0"
                                      ContextMenuOpening="DocumentPositionsDataGrid_ContextMenuOpening"
                                      PreviewMouseRightButtonDown="DocumentPositionsDataGrid_PreviewMouseRightButtonDown">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem x:Name="OpenPositionMenuItem"
                                                  Header="Otworz pozycje"
                                                  Click="OpenPositionMenuItem_Click">
                                        </MenuItem>

                                        <MenuItem x:Name="AddPositionMenuItem"
                                                  Header="Dodaj pozycje"
                                                  Click="AddPositionMenuItem_Click">
                                        </MenuItem>

                                        <MenuItem x:Name="DeletePositionMenuItem"
                                                  Header="Usun pozycje"
                                                  Click="DeletePositionMenuItem_Click">
                                        </MenuItem>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="DocumentPositionsDataGridRow_PreviewMouseRightButtonDown" />
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Towar" Binding="{Binding TowarKod}" Width="1.1*" />
                                    <DataGridTextColumn Header="Nazwa" Binding="{Binding TowarNazwa}" Width="2*" />
                                    <DataGridTextColumn Header="Ilosc" Binding="{Binding IloscJednostkowa, StringFormat=N2}" Width="0.7*" />
                                    <DataGridTextColumn Header="Jednostka" Binding="{Binding Jednostka}" Width="0.7*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="3"
                        Margin="0,18,0,0"
                        Padding="12,10"
                        CornerRadius="4"
                        Background="#F6EFE6"
                        BorderBrush="#D4C9BA"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SecondaryDocumentActionButton"
                        Width="150"
                        Height="32"
                        Margin="0,0,10,0"
                        Style="{StaticResource GhostActionButtonStyle}"
                        Click="DocumentActionButton_Click"
                        Visibility="Collapsed" />
                    <Button x:Name="DocumentActionButton"
                        Width="170"
                        Height="32"
                        Margin="0,0,10,0"
                        Style="{StaticResource FooterActionButtonStyle}"
                        Click="DocumentActionButton_Click"
                        Visibility="Collapsed" />
                        <Button x:Name="SaveButton"
                                Width="160"
                                Height="32"
                                Style="{StaticResource FooterActionButtonStyle}"
                                Click="SaveButton_Click"
                                Content="Zapisz" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>