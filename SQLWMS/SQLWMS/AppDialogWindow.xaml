<Window x:Class="SQLWMS.AppDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Komunikat"
    Width="500"
    MinWidth="500"
    MaxWidth="500"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Bahnschrift"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="DialogActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#173B47" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#173B47" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#224C5A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#102B34" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogGhostButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogActionButtonStyle}">
            <Setter Property="Background" Value="#FBF8F3" />
            <Setter Property="Foreground" Value="#173B47" />
            <Setter Property="BorderBrush" Value="#CDBEAD" />
        </Style>

        <Style x:Key="HeaderCloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#8A8A8A" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#173B47" />
                                <Setter Property="Background" Value="#11000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DropShadowEffect x:Key="DialogShadowEffect"
                          BlurRadius="22"
                          ShadowDepth="0"
                          Color="#3B2012"
                          Opacity="0.18" />
    </Window.Resources>

    <Border Margin="12"
            Background="#FBF8F3"
            CornerRadius="6"
            BorderBrush="#D8CEC0"
            BorderThickness="1"
            Effect="{StaticResource DialogShadowEffect}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="0,0,0,2"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TitleTextBlock"
                           Margin="18,16,14,0"
                           Foreground="#173B47"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Text="Komunikat" />

                <Button Grid.Column="1"
                        Width="34"
                        Height="34"
                        Margin="0,10,12,0"
                        VerticalAlignment="Top"
                        Style="{StaticResource HeaderCloseButtonStyle}"
                        Click="CloseButton_Click"
                        Content="X" />
            </Grid>

            <Grid Grid.Row="1" Margin="22,14,22,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="IconBadgeBorder"
                        Width="38"
                        Height="38"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="#FFF2E8"
                        BorderBrush="#E7B089"
                        BorderThickness="1"
                        CornerRadius="19">
                    <Grid>
                        <TextBlock x:Name="IconTextBlock"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#6C4F00"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Text="!" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Margin="6,2,0,0">
                    <TextBlock x:Name="HeadlineTextBlock"
                               Foreground="#173B47"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Text="Uwaga" />
                    <TextBlock x:Name="MessageTextBlock"
                               Margin="0,6,0,0"
                               Foreground="#324B55"
                               FontSize="14"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2"
                    Background="#F4EFE7"
                    CornerRadius="0,0,6,6"
                    Padding="18,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SecondaryButton"
                            Width="108"
                            Height="34"
                            Margin="0,0,10,0"
                            Visibility="Collapsed"
                            Style="{StaticResource DialogGhostButtonStyle}"
                            Click="SecondaryButton_Click"
                            Content="Anuluj" />
                    <Button x:Name="OkButton"
                            Width="128"
                            Height="34"
                            HorizontalAlignment="Right"
                            IsDefault="True"
                            Style="{StaticResource DialogActionButtonStyle}"
                            Click="OkButton_Click"
                            Content="OK" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>