                                        </Border>
                                    </Grid>

                                    <Border x:Name="DocumentsPaginationPanel"
                                            Grid.Row="2"
                                            Margin="0,10,0,0"
                                            Padding="10,8"
                                            Visibility="Collapsed"
                                            CornerRadius="4"
                                            Background="#F6EFE6"
                                            BorderBrush="#D4C9BA"
                                            BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Orientation="Horizontal">
                                                <Button x:Name="DocumentsPreviousPageButton"
                                                        Width="104"
                                                        Height="28"
                                                        Style="{StaticResource SectionActionButtonStyle}"
                                                        Click="DocumentsPreviousPageButton_Click"
                                                        Content="Poprzednia" />
                                                <Button x:Name="DocumentsNextPageButton"
                                                        Width="104"
                                                        Height="28"
                                                        Margin="8,0,0,0"
                                                        Style="{StaticResource SectionActionButtonStyle}"
                                                        Click="DocumentsNextPageButton_Click"
                                                        Content="Nastepna" />
                                            </StackPanel>

                                            <TextBlock x:Name="DocumentsPaginationTextBlock"
                                                       Grid.Column="1"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Text="Strona 1 z 1" />

                                            <TextBlock x:Name="DocumentsResultsTextBlock"
                                                       Grid.Column="2"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       FontSize="12"
                                                       Text="0 rekordow" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <TextBlock x:Name="SectionFooterTextBlock"
                                       Visibility="Collapsed" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
