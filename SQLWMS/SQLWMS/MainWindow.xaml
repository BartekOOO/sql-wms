<Window x:Class="SQLWMS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SQLWMS"
        mc:Ignorable="d"
        Title="SQL WMS"
        Width="1040"
        Height="640"
        MinWidth="920"
        MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="#F2EDE4"
        FontFamily="Bahnschrift"
        UseLayoutRounding="True">
    <Window.Resources>
        <LinearGradientBrush x:Key="PageBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F7F2E9" Offset="0" />
            <GradientStop Color="#E6EEE9" Offset="0.58" />
            <GradientStop Color="#DBE6E7" Offset="1" />
        </LinearGradientBrush>

        <SolidColorBrush x:Key="PrimaryBrush" Color="#173B47" />
        <SolidColorBrush x:Key="AccentBrush" Color="#BE6943" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FCFAF6" />
        <SolidColorBrush x:Key="MutedBrush" Color="#65757C" />
        <SolidColorBrush x:Key="CardBrush" Color="#F8F3EA" />

        <Style x:Key="ModuleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="#D9CEC0" />
            <Setter Property="BorderThickness" Value="1.4" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Width" Value="168" />
            <Setter Property="Height" Value="168" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="24"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="6" Opacity="0.11" Color="#2F3D44" />
                            </Border.Effect>
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Background" Value="#FFF8F2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#F0E5D8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#224C5A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#102B34" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#12FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="#284F5D" />
            <Setter Property="BorderThickness" Value="1.2" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#18FFFFFF" />
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#224C5A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#102B34" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionExpanderToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CFC1B2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <TextBlock x:Name="Glyph"
                                       Text="+"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="12"
                                       FontWeight="SemiBold" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Glyph" Property="Text" Value="-" />
                                <Setter Property="Background" Value="#E6EFED" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#DCE8EA" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="#C6D5D8" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#F2E4D6" />
                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FBF2E7" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Canvas IsHitTestVisible="False">
            <Ellipse Width="260" Height="260" Fill="#23BE6943" Canvas.Left="-70" Canvas.Top="-60" />
            <Ellipse Width="260" Height="260" Fill="#17173B47" Canvas.Right="-76" Canvas.Top="150" />
            <Ellipse Width="320" Height="320" Fill="#132D6675" Canvas.Left="760" Canvas.Top="470" />
        </Canvas>

        <Grid Margin="28,14,28,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="44" Height="44" CornerRadius="15" Background="{StaticResource PrimaryBrush}">
                        <TextBlock Text="WMS"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="SQL WMS"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   FontSize="24"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Panel operacyjny"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="12" />
                    </StackPanel>
                </StackPanel>

                        <StackPanel x:Name="HomeOverviewPanel"
                                    Grid.Column="1"
                                    Margin="34,2,0,0"
                                    VerticalAlignment="Center">
                            <Border Background="#19BE6943"
                                CornerRadius="12"
                                Padding="12,5"
                                HorizontalAlignment="Left">
                            <TextBlock Text="Widok glowny"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                            </Border>

                            <TextBlock Margin="0,6,0,0"
                                   MaxWidth="520"
                                   Text="Glowne obszary magazynu"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />

                            <TextBlock Margin="0,4,0,0"
                                   MaxWidth="620"
                                   Text="Dokumenty, magazyny, towary i traceability w jednym miejscu."
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="13"
                                   LineHeight="18"
                                   TextWrapping="Wrap" />
                        </StackPanel>

                <Button x:Name="BackButton"
                        Grid.Column="2"
                        Width="140"
                        Height="40"
                        Visibility="Collapsed"
                        Style="{StaticResource GhostButtonStyle}"
                        Click="BackButton_Click"
                        Content="Powrot do startu" />
            </Grid>

            <Grid Grid.Row="1">
                <Grid x:Name="HomeView">
                    <Grid
                                                    Width="382"
                          Margin="0,10,0,0"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,0,8,8"
                                Style="{StaticResource ModuleButtonStyle}"
                                Click="DocumentsButton_Click">
                            <StackPanel Width="124" VerticalAlignment="Center">
                                <Border Width="42"
                                        Height="42"
                                        CornerRadius="14"
                                        Background="#18224C5A"
                                        HorizontalAlignment="Center">
                                    <Viewbox Width="20" Height="20" Stretch="Uniform">
                                        <Path Stroke="{StaticResource PrimaryBrush}"
                                              StrokeThickness="1.7"
                                              StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Data="M6,2 H13 L17,6 V20 H6 Z M13,2 V6 H17 M9,10 H14 M9,14 H14 M9,18 H13" />
                                    </Viewbox>
                                </Border>

                                <TextBlock Margin="0,12,0,0"
                                           Text="Dokumenty"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center" />

                                <TextBlock Margin="0,6,0,0"
                                           Text="Przyjecia, wydania i przesuniecia."
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="12"
                                           LineHeight="16"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />

                                <TextBlock Margin="0,10,0,0"
                                           Text="Przejdz do sekcji"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Row="0"
                                Grid.Column="1"
                                Margin="8,0,0,8"
                                Style="{StaticResource ModuleButtonStyle}"
                                Click="WarehousesButton_Click">
                            <StackPanel Width="124" VerticalAlignment="Center">
                                <Border Width="42"
                                        Height="42"
                                        CornerRadius="14"
                                        Background="#18224C5A"
                                        HorizontalAlignment="Center">
                                    <Viewbox Width="20" Height="20" Stretch="Uniform">
                                        <Path Stroke="{StaticResource PrimaryBrush}"
                                              StrokeThickness="1.7"
                                              StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Data="M3,9 L10,4 17,9 M5,9 V18 H15 V9 M7,12 H13 M7,15 H13" />
                                    </Viewbox>
                                </Border>

                                <TextBlock Margin="0,12,0,0"
                                           Text="Magazyny"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center" />

                                <TextBlock Margin="0,6,0,0"
                                           Text="Struktury, sektory i przestrzenie pracy."
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="12"
                                           LineHeight="16"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />

                                <TextBlock Margin="0,10,0,0"
                                           Text="Przejdz do sekcji"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,8,8,0"
                                Style="{StaticResource ModuleButtonStyle}"
                                Click="ProductsButton_Click">
                            <StackPanel Width="124" VerticalAlignment="Center">
                                <Border Width="42"
                                        Height="42"
                                        CornerRadius="14"
                                        Background="#18224C5A"
                                        HorizontalAlignment="Center">
                                    <Viewbox Width="20" Height="20" Stretch="Uniform">
                                        <Path Stroke="{StaticResource PrimaryBrush}"
                                              StrokeThickness="1.7"
                                              StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Data="M10,3 L17,7 V15 L10,19 3,15 V7 Z M10,3 L3,7 M10,3 L17,7 M10,11 V19 M3,7 L10,11 17,7" />
                                    </Viewbox>
                                </Border>

                                <TextBlock Margin="0,12,0,0"
                                           Text="Towary"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center" />

                                <TextBlock Margin="0,6,0,0"
                                           Text="Kartoteki, cechy i dane asortymentu."
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="12"
                                           LineHeight="16"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />

                                <TextBlock Margin="0,10,0,0"
                                           Text="Przejdz do sekcji"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Row="1"
                                Grid.Column="1"
                                Margin="8,8,0,0"
                                Style="{StaticResource ModuleButtonStyle}"
                                Click="TraceabilityButton_Click">
                            <StackPanel Width="124" VerticalAlignment="Center">
                                <Border Width="42"
                                        Height="42"
                                        CornerRadius="14"
                                        Background="#18224C5A"
                                        HorizontalAlignment="Center">
                                    <Viewbox Width="20" Height="20" Stretch="Uniform">
                                        <Path Stroke="{StaticResource PrimaryBrush}"
                                              StrokeThickness="1.7"
                                              StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Data="M6,4 H14 V17 H6 Z M8,2 H12 V4 M8,8 H12 M8,11 H12 M8,14 H11 M3,10 H6 M14,10 H17" />
                                    </Viewbox>
                                </Border>

                                <TextBlock Margin="0,12,0,0"
                                           Text="Traceability"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center" />

                                <TextBlock Margin="0,6,0,0"
                                           Text="Historia ruchu, pochodzenie i powiazania."
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="12"
                                           LineHeight="16"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />

                                <TextBlock Margin="0,10,0,0"
                                           Text="Przejdz do sekcji"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>

                <Grid x:Name="SectionView" Visibility="Collapsed">
                    <Border Padding="20"
                        CornerRadius="4"
                            Background="#FBF8F3"
                            BorderBrush="#D4C9BA"
                            BorderThickness="1.4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock x:Name="SectionTitleTextBlock"
                                           Margin="0,2,0,0"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />

                                <TextBlock x:Name="SectionDescriptionTextBlock"
                                           Margin="0,4,0,0"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="12"
                                           LineHeight="16"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel x:Name="SectionToolbarPanel"
                                        Grid.Row="1"
                                        Margin="0,8,0,0"
                                        Visibility="Collapsed">
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition x:Name="SectionAddressSpacerColumn" Width="10" />
                                        <ColumnDefinition x:Name="SectionAddressFilterColumn" Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid>
                                        <TextBox x:Name="SectionCodeFilterTextBox"
                                                 Height="28"
                                                 Padding="10,6"
                                                 Background="White"
                                                 BorderBrush="#D7CCC0"
                                                 BorderThickness="1.2"
                                                 FontSize="13"
                                                 ToolTip="Filtr Kod"
                                                 TextChanged="SectionFilterTextBox_TextChanged" />
                                        <TextBlock Margin="12,0,0,0"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="13"
                                                   IsHitTestVisible="False"
                                                   Text="Kod"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Text, ElementName=SectionCodeFilterTextBox}" Value="" />
                                                                <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=SectionCodeFilterTextBox}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>

                                    <Grid Grid.Column="2">
                                        <TextBox x:Name="SectionNameFilterTextBox"
                                                 Height="28"
                                                 Padding="10,6"
                                                 Background="White"
                                                 BorderBrush="#D7CCC0"
                                                 BorderThickness="1.2"
                                                 FontSize="13"
                                                 ToolTip="Filtr Nazwa"
                                                 TextChanged="SectionFilterTextBox_TextChanged" />
                                        <TextBlock Margin="12,0,0,0"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="13"
                                                   IsHitTestVisible="False"
                                                   Text="Nazwa"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Text, ElementName=SectionNameFilterTextBox}" Value="" />
                                                                <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=SectionNameFilterTextBox}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>

                                    <Grid x:Name="SectionAddressFilterContainer" Grid.Column="4">
                                        <TextBox x:Name="SectionAddressFilterTextBox"
                                                 Height="28"
                                                 Padding="10,6"
                                                 Background="White"
                                                 BorderBrush="#D7CCC0"
                                                 BorderThickness="1.2"
                                                 FontSize="13"
                                                 ToolTip="Filtr Adres"
                                                 TextChanged="SectionFilterTextBox_TextChanged" />
                                        <TextBlock Margin="12,0,0,0"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="13"
                                                   IsHitTestVisible="False"
                                                   Text="Adres"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Text, ElementName=SectionAddressFilterTextBox}" Value="" />
                                                                <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=SectionAddressFilterTextBox}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>

                                </Grid>
                            </StackPanel>

                            <Border Grid.Row="2"
                                        Margin="0,10,0,0"
                                        Padding="10"
                                    CornerRadius="4"
                                    Background="#EDF3F0"
                                    BorderBrush="#D6E0DD"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock x:Name="SectionStatusTextBlock"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Text="Wybierz sekcje do podgladu danych." />

                                    <Grid Grid.Row="1" Margin="0,10,0,0">
                                        <DataGrid x:Name="ProductsDataGrid"
                                                  AutoGenerateColumns="False"
                                                  Visibility="Collapsed"
                                                  IsReadOnly="True"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  CanUserSortColumns="True"
                                                  EnableRowVirtualization="False"
                                                  EnableColumnVirtualization="False"
                                                  HeadersVisibility="Column"
                                                  RowHeaderWidth="0"
                                                  GridLinesVisibility="All"
                                                  HorizontalGridLinesBrush="#DDE5E3"
                                                  VerticalGridLinesBrush="#DCCFC0"
                                                  AlternatingRowBackground="#FFF8F3EA"
                                                  RowBackground="White"
                                                  Background="White"
                                                  BorderBrush="#D6E0DD"
                                                  BorderThickness="1"
                                                  RowDetailsVisibilityMode="Collapsed"
                                                  ScrollViewer.CanContentScroll="False"
                                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                  SelectionMode="Single"
                                                  SelectionUnit="FullRow"
                                                  MinColumnWidth="70">
                                            <DataGrid.RowStyle>
                                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                                    <Setter Property="DetailsVisibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasVariants}" Value="True">
                                                            <Setter Property="DetailsVisibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGrid.RowStyle>
                                            <DataGrid.RowDetailsTemplate>
                                                <DataTemplate>
                                                    <Border Margin="10,0,10,10"
                                                            Padding="10"
                                                            Background="#FFF8F3EA"
                                                            BorderBrush="#DCCFC0"
                                                            BorderThickness="1"
                                                            CornerRadius="2">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding DetailStatus}"
                                                                       Foreground="{StaticResource MutedBrush}"
                                                                       FontSize="12" />
                                                            <DataGrid ItemsSource="{Binding Variants}"
                                                                      Margin="0,8,0,0"
                                                                      AutoGenerateColumns="False"
                                                                      IsReadOnly="True"
                                                                      CanUserAddRows="False"
                                                                      CanUserDeleteRows="False"
                                                                      CanUserSortColumns="True"
                                                                      EnableRowVirtualization="False"
                                                                      EnableColumnVirtualization="False"
                                                                      HeadersVisibility="Column"
                                                                      RowHeaderWidth="0"
                                                                      GridLinesVisibility="All"
                                                                      HorizontalGridLinesBrush="#E5DED5"
                                                                      VerticalGridLinesBrush="#E5DED5"
                                                                      AlternatingRowBackground="#FFFDF9F4"
                                                                      RowBackground="White"
                                                                      Background="White"
                                                                      BorderBrush="#E0D5C8"
                                                                      BorderThickness="1"
                                                                      ScrollViewer.CanContentScroll="False"
                                                                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                                <DataGrid.Columns>
                                                                    <DataGridTextColumn Header="Cecha" Binding="{Binding Cecha}" Width="*" />
                                                                    <DataGridTextColumn Header="Ilosc" Binding="{Binding Ilosc, StringFormat=N2}" Width="120" />
                                                                </DataGrid.Columns>
                                                            </DataGrid>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGrid.RowDetailsTemplate>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Kod" Binding="{Binding Kod}" Width="120" SortMemberPath="Kod" />
                                                <DataGridTextColumn Header="Nazwa" Binding="{Binding Nazwa}" Width="*" SortMemberPath="Nazwa" />
                                                <DataGridTextColumn Header="Warianty" Binding="{Binding LiczbaWariantow}" Width="90" SortMemberPath="LiczbaWariantow" />
                                                <DataGridTextColumn Header="Ilosc" Binding="{Binding SumaIlosci, StringFormat=N2}" Width="110" SortMemberPath="SumaIlosci" />
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <DataGrid x:Name="WarehousesDataGrid"
                                                  AutoGenerateColumns="False"
                                                  Visibility="Collapsed"
                                                  IsReadOnly="True"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  CanUserSortColumns="True"
                                                  EnableRowVirtualization="False"
                                                  EnableColumnVirtualization="False"
                                                  HeadersVisibility="Column"
                                                  RowHeaderWidth="0"
                                                  GridLinesVisibility="All"
                                                  HorizontalGridLinesBrush="#DDE5E3"
                                                  VerticalGridLinesBrush="#DCCFC0"
                                                  AlternatingRowBackground="#FFF8F3EA"
                                                  RowBackground="White"
                                                  Background="White"
                                                  BorderBrush="#D6E0DD"
                                                  BorderThickness="1"
                                                  RowDetailsVisibilityMode="Collapsed"
                                                  ScrollViewer.CanContentScroll="False"
                                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                  SelectionMode="Single"
                                                  SelectionUnit="FullRow"
                                                  MinColumnWidth="70">
                                            <DataGrid.RowStyle>
                                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                                    <Setter Property="DetailsVisibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                            <Setter Property="DetailsVisibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGrid.RowStyle>
                                            <DataGrid.RowDetailsTemplate>
                                                <DataTemplate>
                                                    <Border Margin="10,0,10,10"
                                                            Padding="10"
                                                            Background="#FFF8F3EA"
                                                            BorderBrush="#DCCFC0"
                                                            BorderThickness="1"
                                                            CornerRadius="2">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding DetailStatus}"
                                                                       Foreground="{StaticResource MutedBrush}"
                                                                       FontSize="12" />
                                                            <Border Margin="0,8,0,0"
                                                                    Background="White"
                                                                    BorderBrush="#E0D5C8"
                                                                    BorderThickness="1">
                                                                <Grid Grid.IsSharedSizeScope="True">
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="*" />
                                                                    </Grid.RowDefinitions>

                                                                    <Grid Background="#DDE8EC">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="220" SharedSizeGroup="SectorCodeColumn" />
                                                                            <ColumnDefinition Width="*" SharedSizeGroup="SectorNameColumn" />
                                                                        </Grid.ColumnDefinitions>

                                                                        <TextBlock Margin="14,12"
                                                                                   Foreground="{StaticResource PrimaryBrush}"
                                                                                   FontSize="13"
                                                                                   FontWeight="SemiBold"
                                                                                   Text="Kod sektora" />
                                                                        <TextBlock Grid.Column="1"
                                                                                   Margin="14,12"
                                                                                   Foreground="{StaticResource PrimaryBrush}"
                                                                                   FontSize="13"
                                                                                   FontWeight="SemiBold"
                                                                                   Text="Nazwa sektora" />
                                                                    </Grid>

                                                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Sectors}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Border BorderBrush="#E5DED5"
                                                                                        BorderThickness="0,0,0,1"
                                                                                        Background="White"
                                                                                        Padding="0">
                                                                                    <Grid>
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="220" SharedSizeGroup="SectorCodeColumn" />
                                                                                            <ColumnDefinition Width="*" SharedSizeGroup="SectorNameColumn" />
                                                                                        </Grid.ColumnDefinitions>

                                                                                        <TextBlock Margin="14,9"
                                                                                                   Foreground="{StaticResource PrimaryBrush}"
                                                                                                   FontSize="13"
                                                                                                   Text="{Binding Kod}" />
                                                                                        <TextBlock Grid.Column="1"
                                                                                                   Margin="14,9"
                                                                                                   Foreground="{StaticResource PrimaryBrush}"
                                                                                                   FontSize="13"
                                                                                                   Text="{Binding Nazwa}"
                                                                                                   TextWrapping="Wrap" />
                                                                                    </Grid>
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </Grid>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGrid.RowDetailsTemplate>
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="" Width="34" IsReadOnly="True">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <ToggleButton Style="{StaticResource SectionExpanderToggleStyle}"
                                                                          IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                                          Checked="WarehouseExpander_Checked"
                                                                          Unchecked="MasterExpander_Unchecked" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="Kod" Binding="{Binding Kod}" Width="100" SortMemberPath="Kod" />
                                                <DataGridTextColumn Header="Nazwa" Binding="{Binding Nazwa}" Width="220" SortMemberPath="Nazwa" />
                                                <DataGridTextColumn Header="Adres" Binding="{Binding Adres}" Width="*" SortMemberPath="Adres" />
                                                <DataGridTextColumn Header="Sektory" Binding="{Binding LiczbaSektorow}" Width="80" SortMemberPath="LiczbaSektorow" />
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <Border x:Name="SectionPlaceholderBorder"
                                                Visibility="Collapsed"
                                            Padding="16"
                                                CornerRadius="4"
                                                Background="#FFF7F1E8">
                                            <StackPanel>
                                                <TextBlock Text="Widok w przygotowaniu"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold" />
                                                <TextBlock x:Name="SectionPlaceholderTextBlock"
                                                           Margin="0,10,0,0"
                                                           Foreground="{StaticResource PrimaryBrush}"
                                                           FontSize="16"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>

                            <TextBlock x:Name="SectionFooterTextBlock"
                                       Visibility="Collapsed" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
