<Window x:Class="SQLWMS.CreateDocumentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        Title="Nowy dokument"
        Width="520"
    Height="390"
        MinWidth="520"
    MinHeight="390"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F2EDE4"
        FontFamily="Bahnschrift"
        UseLayoutRounding="True"
        ShowInTaskbar="False">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#173B47" />
        <SolidColorBrush x:Key="AccentBrush" Color="#BE6943" />
        <SolidColorBrush x:Key="MutedBrush" Color="#65757C" />

        <Style x:Key="DialogPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#224C5A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#102B34" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogGhostButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#12FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="#284F5D" />
            <Setter Property="BorderThickness" Value="1.2" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#18FFFFFF" />
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22,18,22,18">
        <Border Background="#FBF8F3"
                BorderBrush="#D4C9BA"
                BorderThickness="1.4"
                CornerRadius="4"
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Nowy dokument"
                               Foreground="{StaticResource PrimaryBrush}"
                               FontSize="22"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="DocumentTypeTextBlock"
                               Margin="0,6,0,0"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Grid Grid.Row="2" Margin="0,18,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Typ dokumentu"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       FontSize="13"
                                       FontWeight="SemiBold" />
                            <Border Margin="0,8,0,0"
                                    Height="34"
                                    Padding="10,7"
                                    Background="#F6F2EB"
                                    BorderBrush="#D7CCC0"
                                    BorderThickness="1.2"
                                    CornerRadius="4">
                                <TextBlock x:Name="DocumentTypeValueTextBlock"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           FontSize="13"
                                           FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Data wystawienia"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       FontSize="13"
                                       FontWeight="SemiBold" />
                            <dxe:DateEdit x:Name="DocumentDateEdit"
                                          Margin="0,8,0,0"
                                          Height="34"
                                          NullText="Wybierz date"
                                          Mask="dd.MM.yyyy"
                                          MaskUseAsDisplayFormat="True"
                                          Background="White"
                                          BorderBrush="#D7CCC0"
                                          BorderThickness="1.2"
                                          FontSize="13"
                                          VerticalContentAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,18,0,0">
                        <TextBlock Text="Seria"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold" />
                        <TextBox x:Name="SeriesTextBox"
                                 Margin="0,8,0,0"
                                 Height="34"
                                 MinWidth="0"
                                 Padding="10,6"
                                 Background="White"
                                 BorderBrush="#D7CCC0"
                                 BorderThickness="1.2"
                                 FontSize="13"
                                 VerticalContentAlignment="Center" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="3" Margin="0,28,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="ValidationTextBlock"
                               VerticalAlignment="Center"
                               Foreground="#B42318"
                               FontSize="12"
                               TextWrapping="Wrap" />

                    <Button Grid.Column="1"
                            Width="96"
                            Height="30"
                            Margin="0,0,8,0"
                            Style="{StaticResource DialogGhostButtonStyle}"
                            Click="CancelButton_Click"
                            Content="Anuluj" />

                    <Button Grid.Column="2"
                            Width="120"
                            Height="30"
                            Style="{StaticResource DialogPrimaryButtonStyle}"
                            Click="SaveButton_Click"
                            Content="Zaloz dokument" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>